{
  "name": "django-template-pro",
  "displayName": "Django Template Pro",
  "description": "🚀 Supercharge your Django development with 50+ intelligent snippets for templates, forms, filters, and more",
  "publisher": "quinterodev",
  "version": "1.0.0",
  "icon": "logo.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuinteroDev/django-template-pro"
  },
  "bugs": {
    "url": "https://github.com/QuinteroDev/django-template-pro/issues"
  },
  "homepage": "https://github.com/QuinteroDev/django-template-pro#readme",
  "license": "MIT",
  "keywords": [
    "django",
    "django-templates",
    "django-snippets",
    "python",
    "django-html",
    "snippets",
    "autocomplete",
    "templates",
    "django-forms",
    "django-filters",
    "web-development",
    "productivity",
    "django-tags",
    "bootstrap",
    "htmx"
  ],
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:django-html",
    "onLanguage:html"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "django-html",
        "aliases": [
          "Django HTML",
          "django-html"
        ],
        "extensions": [
          ".html",
          ".djhtml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "html",
        "aliases": [
          "HTML"
        ],
        "extensions": [
          ".html"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "django-html",
        "path": "./snippets/django-html.json"
      },
      {
        "language": "html",
        "path": "./snippets/django-html.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.92.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "esbuild": "^0.21.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  }
}